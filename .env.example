# Copie para .env.local e preencha. Variáveis NEXT_PUBLIC_* são embutidas no build.
NEXT_PUBLIC_SITE_URL=https://eficienciia.com.br
# GA4 (G-XXXXXXXXXX). Vazio = GA desligado.
NEXT_PUBLIC_GA_ID=
# Meta Pixel. Vazio = Pixel desligado.
NEXT_PUBLIC_META_PIXEL_ID=
# Webhook que recebe o formulário de diagnóstico (n8n, Make ou API própria).
# Sem valor, usa https://n8n.eficienciia.com.br/webhook/salva-formulario
NEXT_PUBLIC_LEAD_WEBHOOK_URL=
